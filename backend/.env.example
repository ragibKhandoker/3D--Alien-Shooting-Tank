# Copy this file to ".env" and fill in your values.

# Neon -> your project -> Dashboard -> "Connect" -> copy the connection string
# Keep ?sslmode=require at the end. Never put this in the frontend.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Any long random string; signs login tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Flask
FLASK_PORT=5000
# 127.0.0.1 = only this PC, 0.0.0.0 = reachable from other machines
FLASK_HOST=127.0.0.1
# 1 = show detailed error pages while developing. Keep 0 on a deployed server.
FLASK_DEBUG=0

# Folder that contains project.py (relative to this backend folder)
GAME_DIR=../First Program
GAME_FILE=project.py
