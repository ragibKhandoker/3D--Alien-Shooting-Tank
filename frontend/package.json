{
  "name": "tank-survival-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "AngularJS frontend for Tank Survival 3D",
  "scripts": {
    "start": "concurrently -n backend,frontend -c green,cyan \"npm:backend\" \"npm:frontend\"",
    "dev": "npm start",
    "server": "npm start",
    "frontend": "node scripts/serve.js --open",
    "backend": "cd ..\\backend && venv\\Scripts\\python app.py"
  },
  "dependencies": {
    "angular": "1.8.3",
    "angular-route": "1.8.3"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "http-server": "14.1.1"
  }
}
