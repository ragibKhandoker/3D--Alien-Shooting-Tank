{
  "name": "tank-survival-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "AngularJS frontend for Tank Survival 3D",
  "scripts": {
    "start": "http-server . -p 4200 -c-1 -o -P http://127.0.0.1:5000",
    "backend": "cd ..\\backend && venv\\Scripts\\python app.py",
    "dev": "concurrently -n backend,frontend -c green,cyan \"npm:backend\" \"npm:start\""
  },
  "dependencies": {
    "angular": "1.8.3",
    "angular-route": "1.8.3"
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "http-server": "14.1.1"
  }
}
